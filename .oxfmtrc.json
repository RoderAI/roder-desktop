{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": ["coverage/**", "out/**", "packages/*/dist/**", "pnpm-lock.yaml", "resources/bin/**"]
}
