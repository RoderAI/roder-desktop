{
  "name": "roder-desktop",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "bundle:roder": "node scripts/bundle-roder.mjs",
    "roder:distro:build": "node scripts/bundle-roder.mjs",
    "roder:distro:release": "node scripts/bundle-roder.mjs --release",
    "roder:distro:update": "node scripts/update-roder-distro.mjs",
    "roder:distro:check": "node scripts/update-roder-distro.mjs --check",
    "dev": "pnpm bundle:roder && electron-forge start",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "build": "pnpm typecheck && electron-forge package",
    "dist": "pnpm make",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @roderai/extension-api build && pnpm --filter @roderai/extension-packager build && tsc --noEmit && pnpm --filter @roderai/extension-api typecheck && pnpm --filter @roderai/extension-packager typecheck && pnpm --filter hello-roder-extension typecheck && pnpm --filter aurora-theme-extension typecheck",
    "doctor": "react-doctor",
    "package": "pnpm build",
    "make": "pnpm typecheck && electron-forge make"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "agentation": "3.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^45.5.0",
    "glob": "^7.2.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "react-doctor": "^0.9.23",
    "storybook": "10.6.9",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@lexical/history": "0.53.0",
    "@lexical/plain-text": "0.53.0",
    "@pierre/diffs": "1.7.2",
    "@pierre/theme": "2.1.0",
    "@pierre/trees": "1.0.0",
    "@roderai/extension-api": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.28",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lexical": "0.53.0",
    "lucide-react": "^1.81.0",
    "node-pty": "^1.1.0",
    "nuqs": "^2.10.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "4.24.3",
    "rehype-harden": "^1.1.9",
    "shiki": "4.6.0",
    "smol-toml": "^1.9.1",
    "streamdown": "^2.8.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "description": "Roder Desktop - a local-first desktop app for the Roder agent harness",
  "author": "RoderAI"
}
