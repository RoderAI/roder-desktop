{
  "name": "gode-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "bundle:gode": "node scripts/bundle-gode.mjs",
    "dev": "pnpm bundle:gode && electron-vite dev",
    "build": "pnpm bundle:gode && tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "sc.gode.desktop",
    "productName": "Gode",
    "icon": "resources/icon.png",
    "mac": {
      "icon": "resources/icon.icns"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/node-pty/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.2",
    "vite": "^7.3.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.14.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  }
}
