{
  "name": "roder-desktop",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "bundle:roder": "node scripts/bundle-roder.mjs",
    "roder:distro:build": "node scripts/bundle-roder.mjs",
    "roder:distro:release": "node scripts/bundle-roder.mjs --release",
    "roder:distro:update": "node scripts/update-roder-distro.mjs",
    "roder:distro:check": "node scripts/update-roder-distro.mjs --check",
    "dev": "pnpm bundle:roder && electron-forge start",
    "build": "pnpm typecheck && electron-forge package",
    "dist": "pnpm make",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @roderai/extension-api build && pnpm --filter @roderai/extension-packager build && tsc --noEmit && pnpm --filter @roderai/extension-api typecheck && pnpm --filter @roderai/extension-packager typecheck && pnpm --filter hello-roder-extension typecheck && pnpm --filter aurora-theme-extension typecheck",
    "doctor": "react-doctor",
    "package": "pnpm build",
    "make": "pnpm typecheck && electron-forge make"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "agentation": "3.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^45.0.0",
    "glob": "^7.2.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react-doctor": "^0.9.18",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lexical/history": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@pierre/diffs": "1.6.1",
    "@pierre/theme": "2.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@roderai/extension-api": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "3.14.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lexical": "0.52.0",
    "lucide-react": "^1.61.0",
    "node-pty": "^1.1.0",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "4.14.8",
    "rehype-harden": "^1.1.8",
    "shiki": "4.5.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "description": "Roder Desktop - a local-first desktop app for the Roder agent harness",
  "author": "RoderAI"
}
