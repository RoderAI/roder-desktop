{
  "name": "@roderai/extension-packager",
  "version": "0.1.0",
  "description": "Package local Roder Desktop extensions into .rdx archives.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "roder-extension-package": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "~6.0.2"
  }
}
